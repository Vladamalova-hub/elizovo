# Сервер
PORT=3001
NODE_ENV=production

# MongoDB (Render предоставляет бесплатно)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/elizovo-news

# JWT Secret (придумайте свой сложный пароль)
JWT_SECRET=your_super_secret_jwt_key_change_this_12345

# VK API Token (получить: https://vk.com/dev)
VK_TOKEN=your_vk_api_token

# Telegram Bot Token (получить: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram API ID и Hash (получить: https://my.telegram.org)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Frontend URL (для CORS)
FRONTEND_URL=https://your-frontend.onrender.com

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=elizovo2024
